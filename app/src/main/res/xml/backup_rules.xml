<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for tailg-compose.

  - sharedpref is excluded entirely: session tokens live in
    EncryptedSharedPreferences (androidx.security). The master key stays in
    Android Keystore, which never migrates, so restoring those files would
    produce undecryptable blobs and a broken session.
  - osmdroid tile cache under filesDir is excluded (re-downloadable, bulky).
  - Local vehicle JSON and non-sensitive DataStore preferences remain eligible
    for transfer. Official `carControlInfo` and its BLE/MQTT credentials stay
    only in the excluded encrypted shared preferences.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="osmdroid" />
</full-backup-content>
