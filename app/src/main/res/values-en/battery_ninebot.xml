  <string name="nb_battery_care_title">Care for every charge.</string>
  <string name="nb_battery_care_charging">Charge with care</string>
  <string name="nb_battery_care_charging_body">Use the correct original charger and follow your vehicle manual. Avoid storing a depleted battery for long periods.</string>
  <string name="nb_battery_care_temperature">Mind the temperature</string>
  <string name="nb_battery_care_temperature_body">Temperature affects battery performance and range. Avoid extreme heat or cold, and charge within the recommended temperature range.</string>
  <string name="nb_battery_care_service">Check regularly</string>
  <string name="nb_battery_care_service_body">Watch for changes in score, temperature and range. Contact official service for maintenance, calibration or replacement.</string>
  <string name="nb_battery_cycles_title">Understanding charge cycles</string>
  <string name="nb_battery_cycles_body">Cycles represent accumulated charge and discharge use, rather than the number of times a charger is connected. Several partial charges may add up to one cycle.\n\nCounting methods vary by battery system. This page shows the reported value.</string>
  <string name="nb_battery_score_title">Understanding the battery score</string>
  <string name="nb_battery_score_body">The score comes from the battery service. Some vehicles report BMS state of health (SOH). It describes battery condition and does not replace a full safety inspection.\n\nIf score or range falls noticeably, sync the latest data and contact official service.</string>
