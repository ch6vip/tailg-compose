<?xml version="1.0" encoding="utf-8"?>
<!--
  Data-extraction rules (Android 12+) for tailg-compose.

  Mirrors backup_rules.xml: encrypted session prefs are excluded from both
  device-to-cloud backup and device-to-device transfer (keystore key does not
  migrate); the osmdroid tile cache is excluded as re-downloadable bulk.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="osmdroid" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="osmdroid" />
    </device-transfer>
</data-extraction-rules>
